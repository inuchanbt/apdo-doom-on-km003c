+
+/// Package an installed backup only after validating its original committed CRC.
+/// This is offline and must reproduce every byte, including committed metadata.
+pub fn package_installed(binary: &[u8]) -> Result<Vec<u8>> {
+    ensure!(binary.len() >= 0x460, "truncated installed application");
+    let mut identity = DeviceInfo::default();
+    identity.parse_firmware_info(&binary[0x420..0x460]);
+    InstalledFirmwareInfo {
+        version: identity.fw_version,
+        date: identity.fw_date,
+        size: u32::from_le_bytes(binary[0x428..0x42c].try_into()?) as usize,
+        crc32: u32::from_le_bytes(binary[0x42c..0x430].try_into()?),
+    }
+    .validate_application(binary)?;
+    let mut raw = binary.to_vec();
+    raw[0x428..0x430].fill(0xff);
+    let output = package(&raw)?;
+    ensure!(
+        FirmwareImage::parse(&output)?.installed_data()? == binary,
+        "restore package does not reproduce installed application"
+    );
+    Ok(output)
+}
 
