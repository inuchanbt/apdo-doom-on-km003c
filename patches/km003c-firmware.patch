+}
+/// A remote host must keep renewing held keys. Expired input is always released.
+#[derive(Default)]
+pub struct RemoteGameInput {
+    buttons: u8,
+    expires_ms: u64,
+}
+impl RemoteGameInput {
+    pub fn clear(&mut self) {
+        self.buttons = 0;
+        self.expires_ms = 0;
+    }
+    pub fn update(&mut self, input: GameInputState, now_ms: u64) -> bool {
+        self.clear();
+        if input.buttons == 0 {
+            return true;
+        }
+        if !(100..=1000).contains(&input.lease_ms) {
+            return false;
+        }
+        self.buttons = input.buttons;
+        self.expires_ms = now_ms.saturating_add(u64::from(input.lease_ms));
+        true
+    }
+    pub fn buttons(&self, now_ms: u64) -> u8 {
+        if now_ms < self.expires_ms {
+            self.buttons
+        } else {
+            0
+        }
+    }
+}
